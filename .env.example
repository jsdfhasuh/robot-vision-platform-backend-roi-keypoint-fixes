APP_NAME=Robot Vision Platform
DATABASE_URL=sqlite:////app/data/db/app.db
STORAGE_DIR=/app/data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
LOG_LEVEL=INFO
LOG_DIR=/app/data/logs
LOG_BACKUP_COUNT=14
MODEL_DIR=/app/models
ALERT_ENABLED=false
ALERT_COOLDOWN_SECONDS=300
NOTIFY_RECOVERY=true
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Event review / retention
EVENT_FRAME_SAMPLE_SECONDS=10
EVENT_FRAME_MAX_PER_EVENT=60
CLEANUP_SAMPLE_FRAME_DAYS=30
CLEANUP_ORPHAN_FILE_DAYS=14
BACKUP_KEEP_COUNT=10
